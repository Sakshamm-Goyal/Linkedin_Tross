NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_KEY=replace-with-a-long-random-reviewer-key

# Obtain these manually from a LinkedIn session you own. Never commit them.
LINKEDIN_LI_AT=
LINKEDIN_JSESSION_ID=
LINKEDIN_USER_AGENT=Mozilla/5.0

# Captured from the current web client's profile request. Update when LinkedIn deploys a new operation hash.
LINKEDIN_PROFILE_QUERY_ID=voyagerIdentityDashProfiles.b5c27c04968c409fc0ed3546575b9b7a
LINKEDIN_PROFILE_VARIABLE_NAME=vanityName

LINKEDIN_TIMEOUT_MS=15000
LINKEDIN_MAX_RETRIES=1
CACHE_TTL_SECONDS=86400
SESSION_HEALTH_TTL_SECONDS=300
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=1 minute
