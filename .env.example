NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_KEY=replace-with-a-long-random-reviewer-key

# Obtain these manually from a LinkedIn session you own. Never commit them.
# Optional: paste the complete Cookie request header from the same session.
LINKEDIN_COOKIE_HEADER=
# Optional overlay for rotating same-session cookies without replacing the seed.
LINKEDIN_COOKIE_PATCH_HEADER=
# Preferred for long headers containing quotes: printf %s "$COOKIE" | base64
LINKEDIN_COOKIE_HEADER_BASE64=
# Optional browser-visible cookie snapshot; takes highest precedence.
LINKEDIN_BROWSER_COOKIE_HEADER_BASE64=
LINKEDIN_LI_AT=
LINKEDIN_JSESSION_ID=
LINKEDIN_USER_AGENT=Mozilla/5.0

# Optional but recommended: persist LinkedIn's refreshed cookies encrypted.
# Keep the key in your secret manager; generate one with: openssl rand -base64 32
LINKEDIN_SESSION_FILE=
LINKEDIN_SESSION_KEY=

# curl_cffi impersonates Chrome TLS/HTTP2 and is the recommended production transport.
LINKEDIN_HTTP_TRANSPORT=curl_cffi
LINKEDIN_PYTHON_BIN=python3
LINKEDIN_TLS_IMPERSONATE=chrome
# Use one sticky residential/ISP endpoint; never rotate IP inside a session.
LINKEDIN_PROXY_URL=
LINKEDIN_APPLICATION_VERSION=0.2.7003
LINKEDIN_ANCHOR_PAGE_KEY=d_flagship3_profile_view_base
LINKEDIN_APPLICATION_INSTANCE=
LINKEDIN_PARENT_SPAN_ID=
LINKEDIN_PAGE_INSTANCE=
LINKEDIN_PAGE_TRACKING_ID=
LINKEDIN_TIMEOUT_MS=15000
LINKEDIN_MAX_RETRIES=1
LINKEDIN_MIN_DELAY_MS=250
LINKEDIN_MAX_DELAY_MS=900
CACHE_TTL_SECONDS=86400
SESSION_HEALTH_TTL_SECONDS=300
SESSION_FAILURE_TTL_SECONDS=60
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=1 minute
